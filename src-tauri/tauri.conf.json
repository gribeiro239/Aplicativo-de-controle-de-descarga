{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APP Descarga",
  "version": "0.5.6",
  "identifier": "br.com.appdescarga.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APP Descarga",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "category": "Business",
    "shortDescription": "Análise e histórico de descargas",
    "longDescription": "Aplicativo local para importação, histórico e análise de valores de descargas.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
